{
  "name": "copilot-swarm",
  "version": "0.1.0",
  "description": "Copilot-swarm (CSW): a native GitHub Copilot CLI plugin for parallel delegation, evidence-gated goal runtime, and plan/execute/review discipline.",
  "type": "module",
  "bin": {
    "csw": "bin/csw.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "runtime/src",
    "mcp",
    "skills",
    "agents",
    "hooks",
    ".github/plugin",
    ".plugin",
    ".mcp.json",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "scan": "node scripts/scan-forbidden.mjs --surface all",
    "pack:dry-run": "npm pack --dry-run",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "node scripts/scan-forbidden.mjs --surface tracked"
  },
  "keywords": [
    "copilot",
    "copilot-cli",
    "copilot-plugin",
    "swarm",
    "agents",
    "orchestration",
    "mcp"
  ],
  "license": "MIT",
  "author": "wjgoarxiv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjgoarxiv/copilot-swarm.git"
  },
  "homepage": "https://github.com/wjgoarxiv/copilot-swarm#readme",
  "bugs": {
    "url": "https://github.com/wjgoarxiv/copilot-swarm/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
