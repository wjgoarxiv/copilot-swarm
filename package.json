{
  "name": "copilot-swarm",
  "version": "0.1.2",
  "description": "Evidence-gated software delivery governance for GitHub Copilot CLI, built on native task, fleet, and task-management surfaces.",
  "type": "module",
  "bin": {
    "csw": "bin/csw.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "runtime/src",
    "skills",
    "agents",
    "hooks",
    ".github/plugin",
    ".plugin",
    "AGENTS.md",
    "README.md",
    "README-Ko-KR.md",
    "cover.png",
    "docs",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "scan": "node scripts/scan-forbidden.mjs --surface all",
    "release:check": "node scripts/release-check.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "npm test && npm run scan && npm run release:check -- --publish && npm run pack:dry-run"
  },
  "keywords": [
    "copilot",
    "copilot-cli",
    "copilot-plugin",
    "swarm",
    "agents",
    "orchestration"
  ],
  "license": "MIT",
  "author": "wjgoarxiv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjgoarxiv/copilot-swarm.git"
  },
  "homepage": "https://github.com/wjgoarxiv/copilot-swarm#readme",
  "bugs": {
    "url": "https://github.com/wjgoarxiv/copilot-swarm/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
